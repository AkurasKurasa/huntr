# Copy this file to .env and fill in the values (Supabase -> Project Settings -> API).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Leave as /api in development (Vite proxies it to the Express server on port 5000).
# For GitHub Pages this is set by the deploy workflow to your Render URL + /api.
VITE_API_URL=/api
