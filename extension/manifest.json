{
  "manifest_version": 3,
  "name": "Huntr — Send applications",
  "short_name": "Huntr",
  "version": "0.3.5",
  "description": "Lets Huntr fill in and send your applications on OnlineJobs.ph and JobStreet from your own logged-in browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Huntr",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.onlinejobs.ph/*",
    "https://onlinejobs.ph/*",
    "https://*.jobstreet.com.ph/*",
    "https://*.jobstreet.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://akuraskurasa.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://akuraskurasa.github.io/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "huntr@akuraskurasa.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
